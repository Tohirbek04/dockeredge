# ── Required ──────────────────────────────────────────────────────────────
# Let's Encrypt account email (certificate expiry notices).
LETSENCRYPT_EMAIL=REPLACE_ME@example.com

# ── Traefik ───────────────────────────────────────────────────────────────
TRAEFIK_VERSION=v3
TRAEFIK_LOG_LEVEL=INFO
# HTTPS request read timeout. 0 = unlimited (needed for long-lived WebSockets
# and slow large uploads). Traefik v3 default is 60s.
TRAEFIK_READ_TIMEOUT=60s
# Access-log RequestPath field: keep | drop | redact
TRAEFIK_ACCESSLOG_PATH=drop

# Optional dashboard — or just run: ./setup.sh --dashboard traefik.example.com
# COMPOSE_FILE=docker-compose.yml:docker-compose.dashboard.yml
# TRAEFIK_DASHBOARD_DOMAIN=traefik.example.com
# Bcrypt hash; keep it in SINGLE quotes (it contains `$`):
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'strong-password'
# TRAEFIK_DASHBOARD_AUTH='admin:$2y$05$REPLACE_ME'

# ── Watchtower ────────────────────────────────────────────────────────────
# WATCHTOWER_IMAGE=nickfedor/watchtower:latest
# Poll interval in seconds.
WATCHTOWER_INTERVAL=300
# Any shoutrrr URL; empty = no notifications. Telegram example:
#   telegram://<bot-token>@telegram?chats=<chat-id>
WATCHTOWER_NOTIFICATION_URL=
# Leave empty unless you use an old image on Docker 29+ (then e.g. 1.52).
WATCHTOWER_DOCKER_API_VERSION=

# ── Private images (GHCR) ─────────────────────────────────────────────────
# Classic PAT with the read:packages scope — entered once, used from then on
# (setup.sh logs in with it on every run). The username is looked up from the
# token. It reads every package your account can access, across accounts/orgs.
# Create one: GitHub → Settings → Developer settings → Tokens (classic).
GHCR_TOKEN=
# GHCR_USER=   # optional; auto-detected from the token

TZ=UTC
